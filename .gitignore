# Dependencies
node_modules/

# Logs and local noise
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Backups the installer and the settings page keep next to real files
*.bak
*.dsh-feishu.bak
*.dsh-feishu.tmp

# Editor and tooling
.vscode/
.idea/
*.swp

# DSH local runtime state: the checkpoint (CONTINUE.md) and collection drafts.
# Deliberately out of the repo — they are per-machine and per-hour, and the
# handover package documents their content instead.
.dsh/

# The package has no dependencies, so a lockfile is a generated empty shell.
pnpm-lock.yaml

# Live run artifacts: evidence for one run, regenerated on demand.
test/live/last-run.json
