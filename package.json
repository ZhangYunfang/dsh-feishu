{
  "name": "dsh-feishu",
  "version": "0.1.3",
  "description": "Feishu / Lark integration for DeepSeek Harness: 10 agent tools covering Bitable, docs, sheets, wiki, dashboards, drive and messages in the user own cloud workspace, plus a user OAuth flow that keeps itself refreshed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/ui/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skill",
    "scripts",
    "docs/feishu-console-setup.md",
    "docs/install-for-others.md",
    "docs/user-guide.md",
    "docs/feishu-capabilities.md",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:live": "node test/live/feishu-live.mjs",
    "test:live:list": "node test/live/feishu-live.mjs --list",
    "install:profile": "pwsh -File scripts/install.ps1",
    "uninstall:profile": "pwsh -File scripts/uninstall.ps1",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Run Liu (upstream) — adapted by ZhangYunfang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhangYunfang/dsh-feishu.git"
  },
  "homepage": "https://github.com/ZhangYunfang/dsh-feishu#readme",
  "bugs": {
    "url": "https://github.com/ZhangYunfang/dsh-feishu/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "bitable",
    "多维表格",
    "飞书",
    "deepseek-harness"
  ],
  "contributors": [
    {
      "name": "ZhangYunfang",
      "url": "https://github.com/ZhangYunfang"
    }
  ]
}
